INSERT INTO categorie( categorie) VALUES ('DE');</sql><sql name="création BDD*">DROP TABLE IF EXISTS resultat_ct;
DROP TABLE IF EXISTS controle_technique;
DROP TABLE IF EXISTS ct_effectue;
DROP TABLE IF EXISTS proprietaire;
DROP TABLE IF EXISTS adresse;
DROP TABLE IF EXISTS ville;
DROP TABLE IF EXISTS categories_detenues;
DROP TABLE IF EXISTS categorie;
DROP TABLE IF EXISTS permis;
DROP TABLE IF EXISTS marque;

CREATE TABLE  marque(
	marque VARCHAR(32) PRIMARY KEY
	);

CREATE TABLE categorie(
	categorie VARCHAR(32) PRIMARY KEY
);

CREATE TABLE permis(
	num_permis VARCHAR(128) PRIMARY KEY
);

CREATE TABLE resultat_ct(
	resultat_ct VARCHAR(32) PRIMARY KEY CHECK (resultat_ct IN ('ok', 'reporte', 'refuse'))
);

CREATE TABLE controle_technique(
	id_ct INTEGER PRIMARY KEY,
	date_ct INTEGER NOT NULL,
	resultat_ct VARCHAR(32) NOT NULL,
	observation_ct VARCHAR(256),
	FOREIGN KEY (resultat_ct) REFERENCES resultat_ct(resultat_ct)
	);

CREATE TABLE ville(
	id_ville INTEGER PRIMARY KEY,
	nom_ville VARCHAR(256) NOT NULL,
	code_postal NUMERIC NOT NULL
);	

CREATE TABLE adresse(
	id_adresse INTEGER PRIMARY KEY,
	id_ville INTEGER NOT NULL,
	num_rue INTEGER,
	rue	VARCHAR(256),
	complement VARCHAR(256),
	FOREIGN KEY (id_ville) REFERENCES ville(id_ville)
);

CREATE TABLE ct_effectue(
	immat VARCHAR(32) NOT NULL,
	id_ct NUMERIC UNIQUE NOT NULL,
	PRIMARY KEY(immat,id_ct),
	FOREIGN KEY (id_ct) REFERENCES controle_technique(id_ct),
	FOREIGN KEY (immat) REFERENCES vehicule(immat)
);

CREATE TABLE proprietaire(
	id_proprio INTEGER PRIMARY KEY,
	nom_proprio VARCHAR(256) NOT NULL,
	prenom_proprio VARCHAR(256) NOT NULL,
	date_naissance VARCHAR5(32) NOT NULL,
	sexe VARCHAR(32) NOT NULL,
	email_proprio VARCHAR(256) NOT NULL,
	id_adresse_proprio INTEGER NOT NULL,
	num_permis VARCHAR(128) NOT NULL,
	FOREIGN KEY (id_adresse_proprio) REFERENCES adresse(id_adresse)
	FOREIGN KEY (num_permis) REFERENCES permis(num_permis  )
);

CREATE TABLE categories_detenues(
	num_permis VARCHAR(128) NOT NULL,
	categorie VARCHAR(32),
	FOREIGN KEY (categorie) REFERENCES categorie(categorie),
	FOREIGN key (num_permis) REFERENCES permis(num_permis),
	PRIMARY KEY (num_permis, categorie)
);
</sql><sql name="SQL 3">SELECT num_rue, rue, nom_ville,code_postal FROM adresse JOIN ville ON ville.id_ville = adresse.id_ville;</sql><sql name="SQL 4">SELECT ville.nom_ville, ville.code_postal, adresse.id_adresse, adresse.num_rue, adresse.rue, adresse.complement FROM adresse JOIN ville ON ville.id_ville = adresse.id_ville;
</sql><sql name="SQL 5">CREATE TABLE permis(
	num_permis VARCHAR(128)
);</sql><sql name="SQL 6">SELECT proprietaire.id_proprio, proprietaire.nom_proprio, proprietaire.prenom_proprio FROM proprietaire;</sql><current_tab id="1"/></tab_sql></sqlb_project>
